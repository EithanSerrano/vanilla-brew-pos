{
  "expo": {
    "name": "Vanilla Brew",
    "slug": "vanilla-brew-sms",
    "scheme": "vanillabrew",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/company-logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/sms-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#202020"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Logo.png",
        "backgroundColor": "#202020"
      },
      "package": "com.renz.vanillabrew"
    },
    "androidStatusBar": {
      "hidden": true
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "gcashSimulate": true,
      "eas": {
        "projectId": "ae2ecedc-4fba-4cb8-8f2f-71ea4f84b691"
      }
    },
    "owner": "eithanserrano"
  }
}
